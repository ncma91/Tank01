<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tank01_gnss</name>
  <version>0.1.0</version>
  <description>Driver for the Unicore UM982 dual-antenna RTK receiver (position + heading) used by the Tank01 prototype.</description>
  <maintainer email="martin.nachbaur@gmx.at">Martin Nachbaur</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <!-- optional: rtcm_msgs (corrections from ntrip_client) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
