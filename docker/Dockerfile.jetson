# Tank01 runtime image for Jetson AGX Orin (JetPack 6 / L4T r36, ROS 2 Humble)
# Build on the Jetson:  docker build -f docker/Dockerfile.jetson -t tank01:jetson .
# Run:                  docker compose -f docker/docker-compose.yml up
ARG BASE_IMAGE=dustynv/ros:humble-ros-base-l4t-r36.2.0
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    ROS_DOMAIN_ID=42

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-can python3-pytest can-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/tank01/ros2_ws
COPY ros2_ws/src ./src
RUN . /opt/ros/humble/setup.sh \
    && (rosdep update && rosdep install --from-paths src --ignore-src -r -y || true) \
    && colcon build --merge-install --cmake-args -DCMAKE_BUILD_TYPE=Release

COPY docker/entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "tank01_bringup", "bringup.launch.py"]
